# =============================================================================
# Staff Display Platform — production environment template
# Copy to /opt/staffdisplay/server/.env and chmod 600. Never commit real values.
# =============================================================================

# --- Environment (enables strict validation) ---
APP_ENV=production

# Optional explicit config file path (defaults to configs/config.production.yaml)
# CONFIG_PATH=/opt/staffdisplay/server/configs/config.production.yaml

# --- HTTP server ---
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=30s
SERVER_IDLE_TIMEOUT=60s

# TLS is terminated at nginx (see deploy/nginx.conf). Only enable app TLS if there
# is no reverse proxy in front of the API.
SERVER_TLS_ENABLED=false
SERVER_TLS_CERT_FILE=
SERVER_TLS_KEY_FILE=

# --- PostgreSQL ---
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USER=staffdisplay
DATABASE_PASSWORD=CHANGE_ME
DATABASE_NAME=staffdisplay
DATABASE_SSLMODE=require
DATABASE_TIMEZONE=Asia/Bangkok
DATABASE_MAX_OPEN_CONNECTIONS=25
DATABASE_MAX_IDLE_CONNECTIONS=5
DATABASE_CONNECTION_MAX_LIFETIME=30m

# --- Logging (JSON to stdout for journald/vector collection) ---
LOGGING_DEVELOPMENT=false
LOGGING_LEVEL=info
LOGGING_ENCODING=json

# --- Auth (FG4) ---
# Generate: openssl rand -base64 48   (must be >= 32 chars, never the dev value)
AUTH_JWT_SECRET=CHANGE_ME
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=720h

# --- CORS ---
# Explicit same-origin list only. Wildcards are rejected when APP_ENV=production.
CORS_ALLOWED_ORIGINS=https://display.example.com

# --- Shutdown ---
APP_SHUTDOWN_TIMEOUT=15s
