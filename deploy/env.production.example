# =============================================================================
# Staff Display Platform — production environment template (FG3)
# Copy to /opt/staffdisplay/server/.env, edit, then `chmod 600`.
# Never commit real values; secrets are better kept in *_FILE secret files
# (systemd LoadCredential=) — see docs/DEPLOYMENT.md §2.
# =============================================================================

# --- Environment (selects configs/config.production.yaml + strict validation) ---
APP_ENV=production

# Optional explicit config file path (replaces the base + profile).
# CONFIG_PATH=/opt/staffdisplay/server/configs/config.production.yaml

# --- HTTP server ---
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=30s
SERVER_IDLE_TIMEOUT=60s

# TLS is terminated at nginx (see deploy/nginx.conf). Only enable app TLS if there
# is no reverse proxy in front of the API.
SERVER_TLS_ENABLED=false
SERVER_TLS_CERT_FILE=
SERVER_TLS_KEY_FILE=

# --- PostgreSQL (must not be 'disable' in production) ---
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USER=staffdisplay
DATABASE_NAME=staffdisplay
DATABASE_SSLMODE=require
DATABASE_TIMEZONE=Asia/Bangkok
DATABASE_MAX_OPEN_CONNECTIONS=25
DATABASE_MAX_IDLE_CONNECTIONS=5
DATABASE_CONNECTION_MAX_LIFETIME=30m

# --- Logging (JSON to stdout for journald/vector; development logging is rejected) ---
LOGGING_DEVELOPMENT=false
LOGGING_LEVEL=info
LOGGING_ENCODING=json

# --- Auth (FG4): the root credential of the deployment ---
# Either the value itself (chmod 600 file) or a secret file — never both.
#   openssl rand -base64 48 | install -m 600 /dev/stdin /etc/staffdisplay/jwt.secret
# AUTH_JWT_SECRET=CHANGE_ME
AUTH_JWT_SECRET_FILE=/etc/staffdisplay/jwt.secret
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=720h

# Rotation window: previous signing keys that are still accepted (max 2, each at
# least as strong as the current key). Remove them once every client has
# re-authenticated. See docs/DEPLOYMENT.md §2.
# AUTH_JWT_PREVIOUS_SECRETS_FILE=/etc/staffdisplay/jwt.previous

# --- Secrets (kept out of .env so `systemctl show` never prints them) ---
#   openssl rand -base64 24 | install -m 600 /dev/stdin /etc/staffdisplay/database.secret
# DATABASE_PASSWORD=CHANGE_ME
DATABASE_PASSWORD_FILE=/etc/staffdisplay/database.secret

# --- CORS (single origin, https, never '*') ---
CORS_ALLOWED_ORIGINS=https://display.example.com

# --- Store default policy (optional overrides of config.production.yaml) ---
# STORE_DEFAULT_TIMEZONE=Asia/Bangkok
# STORE_DEFAULT_STATUS=active
# STORE_SLUG_MIN_LENGTH=3
# STORE_SLUG_MAX_LENGTH=63
# STORE_SLUG_AUTO_GENERATE=true
# STORE_SLUG_EXTRA_RESERVED_SLUGS=admin,portal

# --- Shutdown ---
APP_SHUTDOWN_TIMEOUT=15s
