# =============================================================================
# Staff Display Platform — staging environment template (FG3)
# Copy to /opt/staffdisplay-staging/server/.env, edit, then `chmod 600`.
# Staging uses the same secret rules as production (hardened tier) but a staging
# host, origin and database. See docs/DEPLOYMENT.md §1–§2.
# =============================================================================

# --- Environment (selects configs/config.staging.yaml) ---
APP_ENV=staging

# --- HTTP server (loopback behind nginx) ---
SERVER_HOST=127.0.0.1
SERVER_PORT=8080

# --- PostgreSQL (staging instance; 'prefer' keeps a remote host usable while the
#     transport is being set up — production requires require/verify-ca) ---
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USER=staffdisplay_staging
DATABASE_NAME=staffdisplay_staging
DATABASE_SSLMODE=prefer
DATABASE_TIMEZONE=Asia/Bangkok

# --- Logging (JSON so staging reproduces the production log pipeline) ---
LOGGING_DEVELOPMENT=false
LOGGING_LEVEL=info
LOGGING_ENCODING=json

# --- Auth (FG4): required, >= 32 chars, no placeholder value ---
# AUTH_JWT_SECRET=CHANGE_ME
AUTH_JWT_SECRET_FILE=/etc/staffdisplay-staging/jwt.secret
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=720h

# --- Secrets ---
# DATABASE_PASSWORD=CHANGE_ME
DATABASE_PASSWORD_FILE=/etc/staffdisplay-staging/database.secret

# --- CORS (the staging origin only, https) ---
CORS_ALLOWED_ORIGINS=https://staging.display.example.com

# --- Store default policy (optional) ---
# STORE_SLUG_MIN_LENGTH=3

# --- Shutdown ---
APP_SHUTDOWN_TIMEOUT=15s
