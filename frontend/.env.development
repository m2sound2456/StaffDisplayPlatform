# =============================================================================
# Development environment (used by `npm run dev`)
# =============================================================================

# REST base URL. The Vite dev server proxies this path to the Go API so the
# browser sees a same-origin request exactly like production.
VITE_API_BASE_URL=/api/v1

# Slug used by landing page shortcuts (/s/{slug}).
VITE_DEFAULT_STORE_SLUG=demo

# Optional: override the proxy target (read by vite.config.ts).
# VITE_DEV_API_TARGET=http://192.168.1.20:8080
