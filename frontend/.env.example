# =============================================================================
# Frontend environment template — copy to .env.local for overrides.
# Only VITE_* variables reach the browser bundle. Never put secrets here.
# =============================================================================

# REST base URL (same origin in production, proxied in development).
VITE_API_BASE_URL=/api/v1

# Default store slug used by landing page shortcuts (/s/{slug}).
VITE_DEFAULT_STORE_SLUG=demo

# Development only: proxy target for /api (read by vite.config.ts).
# VITE_DEV_API_TARGET=http://127.0.0.1:8080
