# =============================================================================
# Staging build (`npm run build:staging` / `npm run dev:staging`)
# =============================================================================
# Vite mode "staging". The staging host serves the SPA and the API on the same
# origin (single domain + path routing, BLUEPRINT §32); an absolute API URL is
# rejected by src/lib/envProfile.ts at build time.
# =============================================================================

VITE_API_BASE_URL=/api/v1

# Slug used by the landing page shortcuts (/s/{slug}).
VITE_DEFAULT_STORE_SLUG=demo
