# =============================================================================
# Staff Display Platform — backend environment template
# Copy to backend/.env (never committed, git-ignored) and fill in the real
# values. Precedence: defaults < configs/config.yaml < configs/config.<APP_ENV>.yaml
# < environment < *_FILE secret files. See docs/DEPLOYMENT.md §1–§2.
# =============================================================================

# --- Environment selection ---
# development | staging | production. An unknown value is a startup error.
# production/staging apply the hardened and strict validation tiers.
APP_ENV=development

# --- Config file ---
# Explicit YAML path. Replaces the shared base and the environment profile.
# CONFIG_PATH=

# --- Application ---
# APP_NAME=staffdisplay
# APP_TIMEZONE=Asia/Bangkok
# APP_SHUTDOWN_TIMEOUT=15s

# --- Server ---
# SERVER_HOST=0.0.0.0
# SERVER_PORT=8080
# SERVER_READ_TIMEOUT=15s
# SERVER_WRITE_TIMEOUT=30s
# SERVER_IDLE_TIMEOUT=60s

# --- Server TLS (leave disabled when nginx terminates TLS) ---
# SERVER_TLS_ENABLED=false
# SERVER_TLS_CERT_FILE=
# SERVER_TLS_KEY_FILE=

# --- Database ---
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=CHANGE_ME
DATABASE_NAME=staffdisplay
DATABASE_SSLMODE=disable
DATABASE_TIMEZONE=Asia/Bangkok
# DATABASE_MAX_OPEN_CONNECTIONS=25
# DATABASE_MAX_IDLE_CONNECTIONS=5
# DATABASE_CONNECTION_MAX_LIFETIME=30m

# --- Auth (FG4: JWT access tokens + refresh-token sessions) ---
# Production/staging: generate a strong value (openssl rand -base64 48) and keep
# it in a secret file — never in a YAML config file (startup rejects that).
AUTH_JWT_SECRET=CHANGE_ME
# AUTH_JWT_SECRET_FILE=/etc/staffdisplay/jwt.secret
# Rotation window (max 2 previous keys, comma or newline separated). They only
# VERIFY tokens; new tokens are always signed with AUTH_JWT_SECRET:
# AUTH_JWT_PREVIOUS_SECRETS=CHANGE_ME
# AUTH_JWT_PREVIOUS_SECRETS_FILE=/etc/staffdisplay/jwt.previous
# AUTH_ACCESS_TOKEN_TTL=15m
# AUTH_REFRESH_TOKEN_TTL=720h

# --- Secret file alternative (never set the variable and its _FILE variant together) ---
# DATABASE_PASSWORD_FILE=/etc/staffdisplay/database.secret

# --- CORS (comma separated origins; '*' is rejected, production requires https) ---
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Store default policy (consumed from FG5) ---
# STORE_DEFAULT_TIMEZONE=Asia/Bangkok
# STORE_DEFAULT_STATUS=active
# STORE_SLUG_MIN_LENGTH=1
# STORE_SLUG_MAX_LENGTH=63
# STORE_SLUG_AUTO_GENERATE=true
# STORE_SLUG_EXTRA_RESERVED_SLUGS=admin,portal
