# ---------------------------------------------------------------------------
# Staff Display Platform — repository ignore rules
# ---------------------------------------------------------------------------

# --- OS noise ---
Thumbs.db
Desktop.ini
.DS_Store

# --- Editors / IDE ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json
.idea/
*.swp

# --- Secrets and local environment ---
# Never commit real credentials. Use .env.example templates instead.
.env
.env.*
!.env.example
!*.env.example
# Frontend build-time defaults are intentionally tracked: they contain no secrets
# and make `npm run dev` / `npm run build` work out of the box.
!frontend/.env.development
!frontend/.env.production

# --- Go (backend) ---
backend/build/
backend/.gotmp/
*.exe
*.test.exe
*.out
coverage.out

# --- Node (frontend) ---
node_modules/
frontend/dist/
frontend/dev-dist/
frontend/coverage/
*.tsbuildinfo

# --- Local media storage (FG7 Media Storage — LocalStorage driver) ---
backend/storage/

# --- Logs / runtime artefacts ---
*.log
logs/
tmp/
